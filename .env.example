# Telegram (free reminder channel — opt-in deep link replaces paid WhatsApp)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_LINK_TTL_SEC="900"
FEATURE_TELEGRAM_NUDGES="false"

# Legal Hub (legal.knowbest.ro): legal texts, cookie consent, data-rights requests — and the evidence
# of a parent's answer for a learner under 16 (signed; LEGAL_HMAC_KEY = CONSUMER_HMAC_KEY_TUTOR on
# the Hub, at least 32 characters). Without them a parent's answer can't be recorded, so it isn't applied.
LEGAL_API_URL=""
LEGAL_API_KEY=""
LEGAL_HMAC_KEY=""
